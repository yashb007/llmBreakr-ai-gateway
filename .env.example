# Shared config for `docker-compose up`. Copy to .env and fill in.
# (This is separate from server/.env and web/.env.local, which are for
# running the server/web apps directly on your machine without Docker.)
#
# This gateway needs a MySQL database and a Redis instance — bring your own
# (managed or self-hosted); docker-compose.yml only runs the app container.

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=llmbreakr
DB_USER=llmbreakr
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=6379
# REDIS_PASSWORD=

# Server
JWT_SECRET=
# 32-byte key used to encrypt stored provider credentials at rest
CREDENTIAL_ENCRYPTION_KEY=
# Random secret path used as a deploy/health-check probe endpoint (GET /<value>)
LOADER_HASH=

# Bootstrap super admin account, created on first run
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
