# Shared config for `docker compose up`. Copy to .env and fill in.
# (Separate from server/.env and web/.env.local, which are for running the
# server/web apps directly on your machine without Docker.)
#
# Everything here is optional. With no .env at all the container boots with
# embedded SQLite, an in-process cache, admin@llmbreakr.local / admin as the
# seeded login, and auto-generated secrets persisted in the data volume.
# That is fine for trying it out — set the values below for production.
# docker-compose.yml only runs the app container: bring your own MySQL/Redis.
# From inside the container, "localhost" is the container itself — use a real
# hostname, or host.docker.internal for a service on your machine.

# MySQL — leave DB_HOST empty to use embedded SQLite
DB_HOST=
DB_PORT=3306
DB_NAME=llmbreakr
DB_USER=llmbreakr
DB_PASSWORD=

# Redis — leave REDIS_HOST empty to use the in-process cache (single instance only).
# Must be a full URL, e.g. redis://user:pass@host:6379 (REDIS_PORT/REDIS_PASSWORD are unused)
REDIS_HOST=

# Server — auto-generated and persisted if empty
JWT_SECRET=
# 32-byte hex key used to encrypt stored provider credentials at rest.
# Never change it once credentials are stored.
CREDENTIAL_ENCRYPTION_KEY=
# Random secret path used as a deploy/health-check probe endpoint (GET /<value>).
# The route is disabled when empty.
LOADER_HASH=

# Bootstrap super admin, created on first run (password is always "admin" — change it)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=

# Dashboard auth cookies are marked Secure when NODE_ENV=production (always, in Docker),
# so login over plain http:// fails in Safari or on non-localhost hosts.
# Set to false if you're serving the dashboard over HTTP; keep true behind HTTPS.
# COOKIE_SECURE=
