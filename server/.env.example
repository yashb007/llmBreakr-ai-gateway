# Copy this file to .env and fill in real values for production. Never
# commit .env. All of it is optional — with nothing set at all, the server
# boots with sane local defaults: embedded SQLite, an in-process cache
# instead of Redis, admin@llmbreakr.local / admin as the seeded login, and
# an auto-generated JWT secret + credential encryption key persisted to
# server/data/.secrets.json (see config/secrets.js) so they survive restarts.

PORT=4000
# Random secret path used as a deploy/health-check probe endpoint (GET /<value>).
# The route is disabled when empty.
LOADER_HASH=

# Bootstrap super admin account, created on first run.
# Defaults to admin@llmbreakr.local / "Admin" if unset — the seeded
# password is always "admin" regardless (see models/seed.js).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=

# 32-byte key used to encrypt stored provider credentials at rest.
# Auto-generated and persisted to server/data/.secrets.json if unset —
# set your own for production, and never change it once credentials have
# been stored, or they become permanently undecryptable.
CREDENTIAL_ENCRYPTION_KEY=

# Database
# Leave DB_HOST unset to use an embedded SQLite file (zero-config, single
# instance only) at server/data/llmbreakr.sqlite, or override that path with
# DB_SQLITE_PATH. Set DB_HOST to use MySQL instead, recommended for production.
# DB_SQLITE_PATH=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
# Leave REDIS_HOST unset to use an in-process cache (zero-config, single
# instance only — rate limits/budgets/key cache live only in this process's
# memory and reset on restart). Set REDIS_HOST (a full connection URL, e.g.
# redis://user:pass@host:port) to use real Redis instead, recommended for
# production or anything running more than one instance.
REDIS_HOST=
REDIS_PORT=6379
# REDIS_PASSWORD=

# Auto-generated and persisted to server/data/.secrets.json if unset.
JWT_SECRET=
