# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
# Random secret path used as a deploy/health-check probe endpoint (GET /<value>)
LOADER_HASH=

# Bootstrap super admin account, created on first run
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=

# 32-byte key used to encrypt stored provider credentials at rest
CREDENTIAL_ENCRYPTION_KEY=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

JWT_SECRET=
